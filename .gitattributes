# 統一換行：原始碼與文字檔一律 LF
* text=auto eol=lf

# Shell 腳本必須是 LF，否則 macOS 會拒絕執行
*.sh text eol=lf
mac/src/script.sh text eol=lf
mac/*.app/Contents/Resources/script text eol=lf

# 二進位檔案：不要做任何換行轉換或 diff
*.cape binary
*.zip binary
*.icns binary
*.nib binary
*.app/Contents/MacOS/launcher binary
*.app/Contents/_CodeSignature/** binary
*.app/Contents/Resources/MainMenu.nib/** binary
